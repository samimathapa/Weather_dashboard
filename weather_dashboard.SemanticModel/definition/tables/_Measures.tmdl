table _Measures
	lineageTag: da5eeb21-64af-4789-9749-12fabc8b92e1

	measure Curr_TempC = SUM(current_weather[current.temp_c]) & " °C"
		lineageTag: 93887d92-7985-4463-b53b-81d7bdca977f

	measure Curr_TempF = SUM(current_weather[current.temp_f]) & " °F"
		lineageTag: 74ad1f2e-283e-4f94-bba0-b6de767067ac

	measure Curr_TempBoth = ```
			
			FORMAT(SUM(current_weather[current.temp_c]), "0.0") & "°C / " & 
			FORMAT(SUM(current_weather[current.temp_f]), "0.0") & "°F"
			```
		lineageTag: 79507bfe-9f3f-4a1c-9929-3e6fc088f11f

	measure Last_Updated_Date = "Last Updated: " &FORMAT(FIRSTNONBLANK(current_weather[current.last_updated], ""), "dd/ mm")
		lineageTag: a4b2e349-c6db-4cfd-8505-5ddaa72b31e5

	measure Wind_Speed = SUM(current_weather[current.wind_kph]) & " Kph"
		lineageTag: 77d5fafc-bfd4-44c5-ae19-8ed8c7dfcc4e

	measure Visibility_KM = SUM(current_weather[current.vis_km]) & " Km"
		lineageTag: db1ad353-f3bd-4869-a6f8-26916a47baf3

	measure Pressure_in = FORMAT(SUM(current_weather[current.pressure_in]), "0.00" & " inch")
		lineageTag: 3676f948-0cff-45c7-9ac0-b38469901f11

	measure precipitation_in = SUM(current_weather[current.precip_in]) & " inch"
		lineageTag: 4b6d5792-1ba1-4f7d-a925-42a7067f3295

	measure Forecast_TempC = ```
			FORMAT(AVERAGE(forecast_day[forecast.forecastday.day.avgtemp_c]), "0.0") & "°C " 
			
			```
		lineageTag: 552dbe69-d6f9-4bca-aa10-3600ceeef074

	measure 'CO Color' =
			
			VAR AQI = ROUND(SELECTEDVALUE('current_weather'[current.air_quality.co]), 0)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        AQI <= 80,  "#43d946",   -- Good (Green)
			        AQI <= 120, "#fff570",   -- Moderate (Yellow)
			        AQI <= 160, "#ff9800",   -- Poor (Orange)
			        AQI <= 200, "#d99304",   -- Unhealthy (Red)
			        AQI <= 300, "#ff5b0f",   -- Severe (Purple)
			        "#d95243"                -- Hazardous (Dark Maroon)
			    )
		lineageTag: 211ec9af-fe32-41fc-819f-c7977cd895ee

