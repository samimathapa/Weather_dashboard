	measure max_value = 200
		formatString: 0
		lineageTag: 0a2b2b15-c54d-4b60-9496-423a2d016630

	measure leftvalue_pm10 = [max_value] - SUM(current_weather[current.air_quality.pm10])
		lineageTag: 04ea701e-603a-41ad-94d5-0d70f6826097

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
